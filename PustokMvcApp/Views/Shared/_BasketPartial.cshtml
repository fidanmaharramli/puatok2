@using PustokMvcApp.ViewModels.BasketVms
@model List<BasketItemVm>

    
<div class="cart-total">
    <span class="text-number">
        @Model.Count
    </span>
    <span class="text-item">
        Shopping Cart
    </span>
    <span class="price">
        @(Model.Sum(x => x.Price * x.Quantity).ToString("F2"))
        <i class="fas fa-chevron-down"></i>
    </span>
</div>
<div class="cart-dropdown-block">
    @* Silmə alınmasa, JavaScript xəta mesajını burada göstərir. *@
    <p class="basket-error text-danger" role="alert" hidden></p>
    @foreach (var basketItem in Model)
    {
        <div class=" single-cart-block ">
            <div class="cart-product">
                <a asp-controller="Books" asp-action="Details" asp-route-id="@basketItem.BookId" class="image">
                    <img src="~/image/products/@basketItem.Image" alt="">
                </a>
                <div class="content">
                    <h3 class="title">
                        <a href="product-details.html">
                            @basketItem.Name
                        </a>
                    </h3>
                    <p class="price"><span class="qty">@basketItem.Quantity ×</span> @basketItem.Price.ToString("F2")</p>
                    @* Form kitabın ID-sini və avtomatik yaradılan antiforgery token-i POST ilə göndərir. *@
                    <form asp-area="" asp-controller="Basket" asp-action="Remove" method="post"
                          asp-antiforgery="true" class="removeBasketForm">
                        <input type="hidden" name="id" value="@basketItem.BookId" />
                        <button type="submit" class="cross-btn" aria-label="Səbətdən sil">
                            <i class="fas fa-times"></i>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    }




    <div class=" single-cart-block ">
        <div class="btn-block">
            <a href="cart.html" class="btn">
                View Cart <i class="fas fa-chevron-right"></i>
            </a>
            <a href="checkout.html" class="btn btn--primary">
                Check Out <i class="fas fa-chevron-right"></i>
            </a>
        </div>
    </div>
</div>


   
