@model List<Book>
@foreach (var book in Model)
{
    <div class="single-slide">
        <div class="product-card">
            <div class="product-header">
                <a href="#" class="author">
                    @book.Author?.FullName
                </a>
                <h3>
                    <a asp-controller="Books" asp-action="Details" asp-route-id="@book.Id">
                        @book.Name
                    </a>
                </h3>
            </div>
            <div class="product-card--body">
                <div class="card-image">
                    <img src="@book.MainImageUrl" alt="@book.Name">
                    <div class="hover-contents">
                        <a asp-controller="Books" asp-action="Details" asp-route-id="@book.Id" class="hover-image">
                            <img src="@book.HoverImageUrl" alt="@book.Name">
                        </a>
                        <div class="hover-btns">
                            <a asp-controller="Basket" asp-action="Add" asp-route-id="@book.Id" class="single-btn addBasket">
                                <i class="fas fa-shopping-basket"></i>
                            </a>
                            <a href="wishlist.html" class="single-btn">
                                <i class="fas fa-heart"></i>
                            </a>
                            <a href="compare.html" class="single-btn">
                                <i class="fas fa-random"></i>
                            </a>
                            <a asp-controller="Books" asp-action="BookModal" asp-route-id="@book.Id" class="single-btn bookModalIcon" aria-label="Quick view: @book.Name">
                                <i class="fas fa-eye"></i>
                            </a>
                        </div>
                    </div>
                </div>
                <div class="price-block">
                    @if (book.DiscountPercent > 0)
                    {
                        var discountedPrice = book.Price - book.Price * book.DiscountPercent / 100m;
                        <span class="price">£@discountedPrice.ToString("F2")</span>
                        <del class="price-old">£@book.Price.ToString("F2")</del>
                        <span class="price-discount">@book.DiscountPercent%</span>
                    }
                    else
                    {
                        <span class="price">£@book.Price.ToString("F2")</span>
                    }
                </div>
            </div>
        </div>
    </div>
}
