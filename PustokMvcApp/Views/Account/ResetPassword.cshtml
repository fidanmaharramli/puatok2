@using PustokMvcApp.ViewModels.UserVms
@model ResetPasswordVm
<main class="page-section inner-page-sec-padding-bottom">
	<div class="container">
		<div class="row justify-content-center">
			<div class="col-sm-12 col-md-12 col-lg-6 col-xs-12">
				<div class="text-danger" asp-validation-summary="ModelOnly"></div>
				<form method="post">
					<div class="login-form">
						<h4 class="login-title">Returning Customer</h4>
						<p><span class="font-weight-bold">I am a returning customer</span></p>
						<div class="row">
							<div class="col-md-12 col-12 mb--15">
								<label asp-for="Password"></label>
								<input class="mb-0 form-control" asp-for="Password"
									   placeholder="Enter your password here...">
								<span asp-validation-for="Password" class="text-danger"></span>
							</div>
							<div class="col-12 mb--20">
								<label asp-for="ConfirmPassword"></label>
								<input class="mb-0 form-control" asp-for="ConfirmPassword" type="password" id="login-password" placeholder="Enter your password">
								<span asp-validation-for="ConfirmPassword" class="text-danger"></span>
							</div>
							
							<div class="col-md-12">
								<button type="submit" class="btn btn-outlined">Reset Password</button>
							</div>
						</div>
					</div>
				</form>
			</div>
		</div>
	</div>
</main>
@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}