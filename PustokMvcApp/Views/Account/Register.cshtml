@using PustokMvcApp.ViewModels.UserVms
@model UserRegisterVm
<main class="page-section inner-page-sec-padding-bottom">
	<div class="container">
		<div class="row justify-content-center">
			<div class="col-sm-12 col-md-12 col-xs-12 col-lg-6 mb--30 mb-lg--0">
				<!-- Login Form s-->
				<form method="post">
					<div class="text-danger" asp-validation-summary="ModelOnly"></div>
					<div class="login-form">
						<h4 class="login-title">New Customer</h4>
						<p><span class="font-weight-bold">I am a new customer</span></p>
						<div class="row">
							<div class="col-md-12 col-12 mb--15">
								<label asp-for="FullName"></label>
								<input class="mb-0 form-control" asp-for="FullName"
									   placeholder="Enter your full name">
                                <span  asp-validation-for="FullName" class="text-danger"></span>
							</div>
							<div class="col-md-12 col-12 mb--15">
								<label asp-for="UserName"></label>
								<input class="mb-0 form-control" asp-for="UserName"
									   placeholder="Enter your user name">
								<span asp-validation-for="UserName" class="text-danger"></span>
							</div>
							<div class="col-12 mb--20">
								<label asp-for="Email"></label>
								<input class="mb-0 form-control" asp-for="Email"
									   placeholder="Enter Your Email Address Here..">
                                <span asp-validation-for="Email" class="text-danger"></span>
							</div>
							<div class="col-lg-6 mb--20">
								<label asp-for="Password"></label>
								<input class="mb-0 form-control" asp-for="Password"
									   placeholder="Enter your password">
                                <span asp-validation-for="Password" class="text-danger"></span>
							</div>
							<div class="col-lg-6 mb--20">
								<label asp-for="ConfirmPasword"></label>
								<input class="mb-0 form-control" asp-for="ConfirmPasword"
									   placeholder="Repeat your password">
                                <span asp-validation-for="ConfirmPasword" class="text-danger"></span>
							</div>
							<div class="col-md-12">
								<button type="submit" class="btn btn-outlined">Register</button>
							</div>
						</div>
					</div>
				</form>
			</div>
			
		</div>
	</div>
</main>
@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}