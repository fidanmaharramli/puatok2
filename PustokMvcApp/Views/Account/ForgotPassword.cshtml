@using PustokMvcApp.ViewModels.UserVms	
@model ForgotPasswordVm
<main class="page-section inner-page-sec-padding-bottom">
	<div class="container">
		<div class="row justify-content-center">
			<div class="col-sm-12 col-md-12 col-lg-6 col-xs-12">
				<div class="text-danger" asp-validation-summary="ModelOnly"></div>
				<form method="post">
					<div class="login-form">
						<h4 class="login-title">Forgot password</h4>
						<p><span class="font-weight-bold">I am a returning customer</span></p>
					</div>
						<div class="row">
							<div class="col-md-12 col-12 mb--15">
								<label asp-for="	Email"></label>
								<input class="mb-0 form-control" asp-for="Email"
									   placeholder="Enter you email address here...">
								<span asp-validation-for="Email" class="text-danger"></span>
                        </div>
							
							<div class="col-md-12">
								<button type="submit" class="btn btn-outlined">Send Reset Link</button>
							</div>
						</div>
				</form>
			</div>
		</div>
	</div>
</main>
@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}