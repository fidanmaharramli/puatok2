@model UserDetailsVm
@{
    ViewData["Title"] = "User Details";
}

<h1 class="h3 mb-4 text-gray-800">User Details</h1>
<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">@Model.UserName</h6>
    </div>
    <div class="card-body">
        <dl class="row mb-4">
            <dt class="col-sm-3">Full name</dt><dd class="col-sm-9">@Model.FullName</dd>
            <dt class="col-sm-3">Username</dt><dd class="col-sm-9">@Model.UserName</dd>
            <dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.Email</dd>
            <dt class="col-sm-3">Roles</dt><dd class="col-sm-9">@(Model.Roles.Count == 0 ? "No role" : string.Join(", ", Model.Roles))</dd>
            <dt class="col-sm-3">Email confirmed</dt><dd class="col-sm-9">@(Model.EmailConfirmed ? "Yes" : "No")</dd>
            <dt class="col-sm-3">Status</dt><dd class="col-sm-9">@(Model.IsLockedOut ? "Locked" : "Active")</dd>
            @if (Model.IsLockedOut)
            {
                <dt class="col-sm-3">Locked until (UTC)</dt><dd class="col-sm-9">@Model.LockoutEnd?.UtcDateTime.ToString("yyyy-MM-dd HH:mm")</dd>
            }
            <dt class="col-sm-3">User ID</dt><dd class="col-sm-9 text-break">@Model.Id</dd>
        </dl>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
        <a asp-action="Index" class="btn btn-secondary">Back to Users</a>
    </div>
</div>
