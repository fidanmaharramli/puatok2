@model UserDetailsVm
@{
    ViewData["Title"] = "Delete User";
}

<h1 class="h3 mb-4 text-gray-800">Delete User</h1>
<div class="row">
    <div class="col-lg-8">
        <div class="card shadow mb-4 border-left-danger">
            <div class="card-body">
                <div asp-validation-summary="All" class="text-danger" role="alert"></div>
                @if (Model.IsAdmin)
                {
                    <div class="alert alert-danger" role="alert">Admin users cannot be deleted.</div>
                }
                else
                {
                    <p>Are you sure you want to delete this user? This action cannot be undone.</p>
                }
                <dl class="row">
                    <dt class="col-sm-3">Full name</dt><dd class="col-sm-9">@Model.FullName</dd>
                    <dt class="col-sm-3">Username</dt><dd class="col-sm-9">@Model.UserName</dd>
                    <dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.Email</dd>
                </dl>
                <form asp-action="Delete" method="post">
                    <input asp-for="Id" type="hidden" />
                    @if (!Model.IsAdmin)
                    {
                        <button type="submit" class="btn btn-danger">Delete User</button>
                    }
                    <a asp-action="Index" class="btn btn-secondary">Back to Users</a>
                </form>
            </div>
        </div>
    </div>
</div>
