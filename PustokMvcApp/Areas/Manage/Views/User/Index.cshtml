@model List<UserDetailsVm>
@{
    ViewData["Title"] = "Users";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Users</h1>
    <a asp-action="Create" class="btn btn-success"><i class="fas fa-user-plus mr-1"></i> Create User</a>
</div>

@if (TempData["UserSuccess"] is string success)
{
    <div class="alert alert-success" role="alert">@success</div>
}
@if (TempData["UserError"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">All users (@Model.Count)</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-hover mb-0">
                <thead class="thead-light">
                    <tr>
                        <th scope="col">Full name</th>
                        <th scope="col">Username</th>
                        <th scope="col">Email</th>
                        <th scope="col">Roles</th>
                        <th scope="col">Status</th>
                        <th scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td class="align-middle">@user.FullName</td>
                            <td class="align-middle">@user.UserName</td>
                            <td class="align-middle">@user.Email</td>
                            <td class="align-middle">@(user.Roles.Count == 0 ? "No role" : string.Join(", ", user.Roles))</td>
                            <td class="align-middle">
                                <span class="badge @(user.IsLockedOut ? "badge-warning" : "badge-success")">
                                    @(user.IsLockedOut ? "Locked" : "Active")
                                </span>
                            </td>
                            <td class="align-middle text-nowrap">
                                <a asp-action="Details" asp-route-id="@user.Id" class="btn btn-sm btn-outline-info">Details</a>
                                <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                @if (user.IsAdmin)
                                {
                                    <span class="badge badge-light ml-2" title="Admin users cannot be deleted">Protected admin</span>
                                }
                                else
                                {
                                    <a asp-action="Delete" asp-route-id="@user.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                                }
                            </td>
                        </tr>
                    }
                    @if (Model.Count == 0)
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">No users found.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
