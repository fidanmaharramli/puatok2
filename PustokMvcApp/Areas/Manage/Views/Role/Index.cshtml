@model List<RoleListVm>
@{
    ViewData["Title"] = "Roles";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Roles</h1>
    <a asp-action="Create" class="btn btn-success"><i class="fas fa-plus mr-1"></i> Create Role</a>
</div>
@if (TempData["RoleSuccess"] is string success)
{
    <div class="alert alert-success" role="alert">@success</div>
}
<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">All roles (@Model.Count)</h6>
    </div>
    <div class="card-body">
        <p class="text-muted">Assign roles from <a asp-controller="User" asp-action="Index">Users</a> by editing a user.</p>
        <div class="table-responsive">
            <table class="table table-bordered table-hover mb-0">
                <thead class="thead-light">
                    <tr><th scope="col">Role name</th><th scope="col">Users</th></tr>
                </thead>
                <tbody>
                    @foreach (var role in Model)
                    {
                        <tr><td>@role.Name</td><td>@role.UserCount</td></tr>
                    }
                    @if (Model.Count == 0)
                    {
                        <tr><td colspan="2" class="text-center text-muted py-4">No roles found.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
