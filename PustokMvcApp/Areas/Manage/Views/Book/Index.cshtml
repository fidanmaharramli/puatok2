@model List<PustokMvcApp.Models.Book>
@{
    var books = Model;
}

<div class="table-responsive">
        <a href="/manage/book/create" class="btn btn-sm btn-outline-success">Create</a> 
    <table class="table">
        <thead>
            <tr>
                <th scope="col">Name</th>
                <th scope="col">Price</th>  
                <th scope="col">DiscountedPercent</th>
                <th scope="col">Image</th>
                <th scope="col">Settings</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var book in books)
            {
                <tr>
                    <td>@book.Name</td>
                    <td>@book.Price</td>
                    <td>@book.DiscountPercent</td>
                    <td>
                        
                            <img src="@book.MainImageUrl" alt="@book.Name" style="width: 100px; height: 100px;" />
                        
                    </td>
                    <td class="author-actions">
                        <a href="/manage/book/edit/@book.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                        <button type="button" class="btn btn-sm btn-outline-danger delete-book-btn"
                                data-url="@Url.Action("Delete", "Book", new { area = "Manage", id = book.Id })">Delete</button>
                        <a href="/manage/book/details/@book.Id" class="btn btn-sm btn-outline-info">Details</a>

                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<form id="delete-book-form" asp-area="Manage" asp-controller="Book" asp-action="Delete" asp-route-id="" method="post"></form>

@section scripts {
    <script>
        $(".delete-book-btn").on("click", function () {
            var url = $(this).attr("data-url");

            Swal.fire({
                title: "Delete this book?",
                text: "The book and its image records will be removed.",
                icon: "warning",
                showCancelButton: true,
                confirmButtonText: "Delete",
                cancelButtonText: "Cancel"
            }).then((result) => {
                if (result.isConfirmed) {
                    var form = document.getElementById("delete-book-form");
                    form.action = url;
                    form.submit();
                }
            });
        });
    </script>
}
